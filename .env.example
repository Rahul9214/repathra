# Copy this file to .env.local and uncomment the two connection strings.
# .env.local is gitignored. Never commit a real connection string.
# Do not prefix either variable with NEXT_PUBLIC_.
#
# Non-local hosts must include sslmode=require, sslmode=verify-ca, or sslmode=verify-full.
# REPATHRA does not start PostgreSQL in Docker or WSL.
#
# Pooled Neon URL used by the application, seed, and health check.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Direct Neon URL used by migrations. Do not use the pooler host here.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
#
# Clerk operator authentication. Both keys are required before a draft can be saved or published.
# When either key is missing, Journey Studio fails closed and leaves editing disabled.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# CLERK_SECRET_KEY=sk_test_replace_me
# Optional: comma-separated Clerk user IDs explicitly granted operator permissions
# OPERATOR_USER_IDS=user_replace_me
# Optional: comma-separated operator emails explicitly granted operator permissions
# OPERATOR_EMAILS=operator@example.com

